<style>
  .ms-hero {
    --ms-hero-text: {{ section.settings.text_color }};
    --ms-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    position: relative;
    display: flex;
    align-items: center;
    min-height: {{ section.settings.min_height_mobile }}px;
    overflow: hidden;
    background: #111;
    color: var(--ms-hero-text);
  }

  .ms-hero__media {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  .ms-hero__picture,
  .ms-hero__image {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ms-hero__image {
    object-fit: cover;
    object-position: {{ section.settings.image_position_mobile }} center;
  }

  .ms-hero__placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.2;
  }

  /* Dark gradient so the text stays readable over any image */
  .ms-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, var(--ms-hero-overlay)) 0%,
      rgba(0, 0, 0, calc(var(--ms-hero-overlay) * 0.4)) 100%
    );
    pointer-events: none;
  }

  .ms-hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 48px 24px;
  }

  .ms-hero__content {
    max-width: 480px;
  }

  .ms-hero__heading {
    margin: 0 0 16px;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.875rem;
    font-weight: 500;
    line-height: 1.15;
    color: var(--ms-hero-text);
  }

  .ms-hero__text {
    margin: 0 0 24px;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--ms-hero-text);
  }

  .ms-hero__text p {
    margin: 0;
  }

  .ms-hero__button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    border: 1px solid var(--ms-hero-text);
    color: var(--ms-hero-text);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .ms-hero__button:hover {
    background: var(--ms-hero-text);
    color: #111;
  }

  .ms-hero__button svg {
    width: 18px;
    height: 18px;
  }

  @media screen and (min-width: 750px) {
    .ms-hero {
      min-height: {{ section.settings.min_height_desktop }}px;
    }

    .ms-hero__image {
      object-position: {{ section.settings.image_position_desktop }} center;
    }

    /* On desktop the gradient runs left to right, darkest behind the text */
    .ms-hero__overlay {
      background: linear-gradient(
        90deg,
        rgba(0, 0, 0, var(--ms-hero-overlay)) 0%,
        rgba(0, 0, 0, calc(var(--ms-hero-overlay) * 0.3)) 55%,
        rgba(0, 0, 0, 0) 100%
      );
    }

    .ms-hero__inner {
      padding: 64px 64px;
    }

    .ms-hero__content {
      max-width: 520px;
    }

    .ms-hero__heading {
      font-size: 2.5rem;
    }

    .ms-hero__text {
      font-size: 0.875rem;
    }
  }
</style>

<section class="ms-hero" id="ms-hero-{{ section.id }}">
  <div class="ms-hero__media">
    {% if section.settings.image != blank %}
      {% assign image_loading = 'eager' %}
      {% if section.settings.lazy_load %}
        {% assign image_loading = 'lazy' %}
      {% endif %}
      <picture class="ms-hero__picture">
        {% if section.settings.mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 1100 }} 1100w"
            sizes="100vw"
          >
        {% endif %}
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag:
            class: 'ms-hero__image',
            alt: '',
            loading: image_loading,
            widths: '750, 1100, 1500, 2000',
            sizes: '100vw'
        }}
      </picture>
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'ms-hero__placeholder' }}
    {% endif %}
    <div class="ms-hero__overlay"></div>
  </div>

  <div class="ms-hero__inner">
    <div class="ms-hero__content">
      {% if section.settings.heading != blank %}
        <h2 class="ms-hero__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="ms-hero__text">{{ section.settings.text }}</div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link | default: '#' }}" class="ms-hero__button">
          {{ section.settings.button_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 12h18M15 6l6 6-6 6"></path>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MS Hero Banner",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (optional)",
      "info": "Leave empty to use the main image on mobile."
    },
    {
      "type": "select",
      "id": "image_position_desktop",
      "label": "Image focus (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "image_position_mobile",
      "label": "Image focus (mobile)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "checkbox",
      "id": "lazy_load",
      "label": "Lazy load image",
      "info": "Leave off if this is the first section on the page. Turn on if it sits further down.",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your All-Inclusive Glass Bottle Packaging Solution"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Elevate Your Brand, Seal the Scent, and Shine with Style! Exclusive Offer Inside – Craft Your Signature Look Today!</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Height (desktop)",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 460
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Height (mobile)",
      "min": 300,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 420
    }
  ],
  "presets": [
    {
      "name": "MS Sub Banner"
    }
  ]
}
{% endschema %}