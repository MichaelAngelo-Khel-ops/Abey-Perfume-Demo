
<style>
  .ms-logos {
    --ms-logos-bg: {{ section.settings.background_color }};
    --ms-logos-height: {{ section.settings.logo_height_mobile }}px;
    padding: {{ section.settings.padding_mobile }}px 0;
    overflow: hidden;
    background: var(--ms-logos-bg);
  }

  .ms-logos__slider .swiper-wrapper {
    transition-timing-function: linear; /* smooth, constant-speed scrolling */
    align-items: center;
  }

  .ms-logos__slide.swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    height: auto;
    padding: 0 12px;
    box-sizing: border-box;
  }

  .ms-logos__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .ms-logos__image {
    display: block;
    width: auto;
    max-width: 100%;
    height: var(--ms-logos-height);
    object-fit: contain;
  }

  .ms-logos__placeholder {
    width: 100%;
    max-width: 140px;
    height: var(--ms-logos-height);
    opacity: 0.3;
  }

  .ms-logos__empty {
    margin: 0;
    padding: 24px;
    color: #fff;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .ms-logos {
      --ms-logos-height: {{ section.settings.logo_height_desktop }}px;
      padding: {{ section.settings.padding_desktop }}px 0;
    }

    .ms-logos__slide.swiper-slide {
      padding: 0 20px;
    }
  }
</style>

<section class="ms-logos" id="ms-logos-{{ section.id }}">
  {% if section.blocks.size > 0 %}
    <div class="ms-logos__slider" data-ms-logos-slider>
      <div class="swiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide ms-logos__slide" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="ms-logos__link">
              {% else %}
                <div class="ms-logos__link">
              {% endif %}

              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 400
                  | image_tag:
                    class: 'ms-logos__image',
                    loading: 'lazy',
                    alt: block.settings.alt,
                    widths: '160, 240, 400',
                    sizes: '(min-width: 750px) 200px, 50vw'
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'ms-logos__placeholder' }}
              {% endif %}

              {% if block.settings.link != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  {% else %}
    <p class="ms-logos__empty">Add logo blocks to show the slider.</p>
  {% endif %}
</section>

{%- comment -%}
  Remove this tag if you already load swiper-bundle.min.js once in theme.liquid.
{%- endcomment -%}


<script>
  (() => {
    const root = document.getElementById('ms-logos-{{ section.id }}');
    const el = root?.querySelector('[data-ms-logos-slider] .swiper');
    if (!el) return;

    const perViewMobile = {{ section.settings.logos_mobile | times: 1 }};
    const perViewDesktop = {{ section.settings.logos_desktop | times: 1 }};
    const wantsAutoplay = {{ section.settings.autoplay | json }};
    const secondsPerLogo = {{ section.settings.seconds_per_logo }};

    const initSlider = () => {
      if (el.swiper) return true;
      if (typeof window.Swiper !== 'function') return false;

      const slideCount = el.querySelectorAll(':scope > .swiper-wrapper > .swiper-slide').length;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Looping needs more slides than are visible at once
      const canLoop = slideCount >= Math.ceil(Math.max(perViewMobile, perViewDesktop)) + 1;
      const canAutoplay = wantsAutoplay && canLoop && !reducedMotion;

      const options = {
        slidesPerView: perViewMobile,
        spaceBetween: 0,
        grabCursor: true,
        loop: canLoop,
        watchOverflow: true,
        allowTouchMove: slideCount > 1,
        breakpoints: {
          750: { slidesPerView: perViewDesktop },
        },
      };

      if (canAutoplay) {
        options.speed = secondsPerLogo * 1000;
        options.autoplay = {
          delay: 0,
          disableOnInteraction: false,
          pauseOnMouseEnter: true,
        };
      }

      try {
        new window.Swiper(el, options);
      } catch (error) {
        console.error('MS Logos: Swiper initialization failed.', error);
      }

      return true;
    };

    // Swiper may still be loading, so retry briefly, then on window load.
    if (!initSlider()) {
      let tries = 0;
      const timer = setInterval(() => {
        tries += 1;
        if (initSlider() || tries > 50) clearInterval(timer);
      }, 100);
      window.addEventListener('load', initSlider, { once: true });
    }

    // Theme editor: jump to the logo when its block is selected
    root.addEventListener('shopify:block:select', (event) => {
      const swiper = el.swiper;
      if (!swiper) return;

      const slide = Array.from(swiper.wrapperEl.children).find((child) =>
        child.contains(event.target)
      );
      if (!slide) return;

      const index = slide.dataset.swiperSlideIndex !== undefined
        ? Number(slide.dataset.swiperSlideIndex)
        : Array.from(swiper.wrapperEl.children).indexOf(slide);

      if (swiper.params.loop) {
        swiper.slideToLoop(index, 0);
      } else {
        swiper.slideTo(index, 0);
      }

      if (swiper.autoplay?.running) swiper.autoplay.stop();
    });
  })();
</script>

{% schema %}
{
  "name": "MS Logo Slider",
  "max_blocks": 24,
  "settings": [
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "select",
      "id": "logos_mobile",
      "label": "Logos visible (mobile)",
      "options": [
        { "value": "1.5", "label": "1.5" },
        { "value": "2", "label": "2" },
        { "value": "2.5", "label": "2.5" },
        { "value": "3", "label": "3" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "logos_desktop",
      "label": "Logos visible (desktop)",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "4.5", "label": "4.5" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "4.5"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto scroll",
      "info": "Needs more logos than are visible at once.",
      "default": true
    },
    {
      "type": "range",
      "id": "seconds_per_logo",
      "label": "Seconds per logo",
      "info": "Lower is faster.",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo height (mobile)",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "logo_height_desktop",
      "label": "Logo height (desktop)",
      "min": 24,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Vertical padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "Vertical padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo image" },
        { "type": "text", "id": "alt", "label": "Alt text", "info": "Brand name, for screen readers." },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MS Logo Slider",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}