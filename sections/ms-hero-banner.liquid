{% comment %}
  Section contract.
  Presents editable sourcing benefits beside a swipeable row of product design cards.
  @example
  Add slide blocks for each product image, title, and optional destination link.
{% endcomment %}

{% style %}
  #ms-hero-banner-{{ section.id }} {
    --ms-section-background: {{ section.settings.background_color }};
    --ms-heading-color: {{ section.settings.heading_color }};
    --ms-copy-color: {{ section.settings.copy_color }};
    --ms-accent-color: {{ section.settings.accent_color }};
    --ms-controls-color: {{ section.settings.controls_color }};
    --ms-card-width: {{ section.settings.card_width }}px;
    --ms-card-width-mobile: {{ section.settings.mobile_card_width }}%;
    --ms-card-height: {{ section.settings.card_height }}px;
    --ms-card-gap: {{ section.settings.space_between }}px;
    --ms-padding-top: {{ section.settings.padding_top }}px;
    --ms-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

{% stylesheet %}
  .ms-hero-banner {
    display: block;
    overflow: hidden;
    background: var(--ms-section-background);
    color: var(--ms-copy-color);
  }

  .ms-hero-banner__layout {
    display: grid;
    grid-template-columns: minmax(15rem, 0.36fr) minmax(0, 0.64fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    max-width: 1600px;
    margin-inline: auto;
    padding-block: var(--ms-padding-top) var(--ms-padding-bottom);
    padding-inline-start: clamp(1.5rem, 8.5vw, 8rem);
  }

  .ms-hero-banner__content {
    min-width: 0;
    padding-inline-end: 1rem;
  }

  .ms-hero-banner__heading {
    max-width: 25rem;
    margin: 0 0 1.25rem;
    color: var(--ms-heading-color);
    font-family: var(--font-heading--family, Georgia, 'Times New Roman', serif);
    font-size: clamp(1.75rem, 2.7vw, 2.5rem);
    font-weight: 500;
    line-height: 1.08;
    text-wrap: balance;
  }

  .ms-hero-banner__benefits {
    display: grid;
    gap: 1rem;
  }

  .ms-hero-banner__benefit {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.45rem;
    align-items: start;
  }

  .ms-hero-banner__check {
    width: 1rem;
    height: 1rem;
    margin-top: 0.2rem;
    color: var(--ms-accent-color);
  }

  .ms-hero-banner__benefit-heading {
    margin: 0;
    color: var(--ms-heading-color);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .ms-hero-banner__benefit-text {
    margin-top: 0.2rem;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .ms-hero-banner__benefit-text p {
    margin: 0;
  }

  .ms-hero-slider {
    display: block;
    min-width: 0;
  }

  .ms-hero-slider__viewport {
    width: 100%;
    overflow: hidden;
  }

  .ms-hero-slider .swiper-wrapper {
    display: flex;
    width: 100%;
    height: 100%;
    box-sizing: content-box;
    transition-property: transform;
  }

  .ms-hero-slider .swiper-slide {
    position: relative;
    flex-shrink: 0;
    width: var(--ms-card-width);
    height: var(--ms-card-height);
    overflow: hidden;
    background: var(--ms-card-background, #f3f3f3);
  }

  .ms-hero-slide__background,
  .ms-hero-slide__overlay {
    position: absolute;
    inset: 0;
  }

  .ms-hero-slide__background {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ms-hero-slide__overlay {
    background: var(--ms-overlay-color);
    opacity: var(--ms-overlay-opacity);
    pointer-events: none;
  }

  .ms-hero-slide__product {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0.75rem 0.75rem 4.25rem;
    object-fit: contain;
  }

  .ms-hero-slide__placeholder {
    color: rgb(0 0 0 / 18%);
  }

  .ms-hero-slide__content {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 0.75rem 1rem;
    background: rgb(34 34 34 / 88%);
    color: var(--ms-card-heading-color);
    text-align: center;
  }

  .ms-hero-slide__heading {
    margin: 0;
    color: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .ms-hero-slide__button {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border: 1px solid var(--ms-button-color);
    padding: 0.45rem 0.8rem;
    background: var(--ms-button-background);
    color: var(--ms-button-color);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 180ms ease;
  }

  .ms-hero-slide__button:hover {
    opacity: 0.78;
  }

  .ms-hero-slide__button:focus-visible,
  .ms-hero-slider__arrow:focus-visible,
  .ms-hero-slider__bullet:focus-visible {
    outline: 2px solid var(--ms-controls-color);
    outline-offset: 3px;
  }

  .ms-hero-slide__button-arrow {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
  }

  .ms-hero-slider__controls {
    display: flex;
    min-height: 2.5rem;
    align-items: center;
    gap: 1rem;
    padding-block-start: 0.75rem;
    padding-inline-end: 1rem;
  }

  .ms-hero-slider__pagination {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .ms-hero-slider__bullet {
    width: 0.45rem;
    height: 0.45rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--ms-controls-color);
    opacity: 0.35;
    cursor: pointer;
  }

  .ms-hero-slider__bullet.ms-is-active {
    opacity: 1;
  }

  .ms-hero-slider__navigation {
    display: flex;
    gap: 0.5rem;
    margin-inline-start: auto;
  }

  .ms-hero-slider__arrow {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    place-items: center;
    border: 1px solid var(--ms-controls-color);
    border-radius: 50%;
    background: transparent;
    color: var(--ms-controls-color);
    cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease, opacity 180ms ease;
  }

  .ms-hero-slider__arrow:hover:not(.ms-is-disabled) {
    background: var(--ms-controls-color);
    color: var(--ms-section-background);
  }

  .ms-hero-slider__arrow.ms-is-disabled {
    opacity: 0.4;
    cursor: default;
  }

  .ms-hero-slider__arrow svg {
    width: 1rem;
    height: 1rem;
  }

  .ms-hero-slider__empty {
    display: grid;
    min-height: var(--ms-card-height);
    place-items: center;
    background: #f3f3f3;
    color: #444;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ms-hero-banner__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
      padding-inline-start: 1rem;
    }

    .ms-hero-banner__content {
      padding-inline-end: 1rem;
    }

    .ms-hero-banner__heading {
      max-width: 24rem;
      margin-bottom: 1.1rem;
      font-size: clamp(1.65rem, 7vw, 2rem);
    }

    .ms-hero-banner__benefits {
      gap: 0.9rem;
    }

    .ms-hero-slider .swiper-slide {
      width: var(--ms-card-width-mobile);
      max-width: 18rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ms-hero-slide__button,
    .ms-hero-slider__arrow {
      transition: none;
    }
  }
{% endstylesheet %}

<section id="ms-hero-banner-{{ section.id }}" class="ms-hero-banner">
  <div class="ms-hero-banner__layout">
    <div class="ms-hero-banner__content">
      {% if section.settings.heading != blank %}
        <h2 class="ms-hero-banner__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      <div class="ms-hero-banner__benefits">
        {% for number in (1..3) %}
          {% liquid
            assign heading_key = 'benefit_' | append: number | append: '_heading'
            assign text_key = 'benefit_' | append: number | append: '_text'
            assign benefit_heading = section.settings[heading_key]
            assign benefit_text = section.settings[text_key]
          %}
          {% if benefit_heading != blank or benefit_text != blank %}
            <div class="ms-hero-banner__benefit">
              <svg class="ms-hero-banner__check" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle cx="8" cy="8" r="6.75" stroke="currentColor" stroke-width="1.2"/>
                <path d="m5.2 8.1 1.8 1.8 3.8-4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"/>
              </svg>
              <div>
                {% if benefit_heading != blank %}
                  <h3 class="ms-hero-banner__benefit-heading">{{ benefit_heading | escape }}</h3>
                {% endif %}
                {% if benefit_text != blank %}
                  <div class="ms-hero-banner__benefit-text rte">{{ benefit_text }}</div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% liquid
      assign slide_index_placeholder = '{index}'
      assign slide_length_placeholder = '{length}'
    %}
    <div class="ms-hero-slider">
      {% if section.blocks.size == 0 %}
        <div class="ms-hero-slider__empty">{{ 'sections.ms_hero_banner.empty' | t }}</div>
      {% else %}
        <div
          class="ms-hero-slider__carousel"
          role="region"
          aria-roledescription="carousel"
          aria-label="{{ 'accessibility.slideshow' | t }}"
          data-slide-label="{{ 'accessibility.slide_status' | t: index: slide_index_placeholder, length: slide_length_placeholder | escape }}"
          data-swiper-src="{{ 'swiper-bundle.min.js' | asset_url }}"
          data-autoplay="{{ section.settings.autoplay }}"
          data-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
          data-speed="{{ section.settings.speed }}"
          data-loop="{{ section.settings.loop }}"
          data-space-between="{{ section.settings.space_between }}"
        >
          <div class="swiper ms-hero-slider__viewport">
            <div class="swiper-wrapper">
              {% for block in section.blocks %}
                {% liquid
                  assign bg_image = block.settings.bg_image
                  assign product_image = block.settings.product_image
                  assign image_loading = 'lazy'
                  assign image_priority = 'auto'
                  if forloop.first
                    assign image_loading = 'eager'
                    assign image_priority = 'high'
                  endif
                %}
                <div
                  class="swiper-slide ms-hero-slide"
                  style="
                    --ms-card-background: {{ block.settings.bg_color }};
                    --ms-overlay-color: {{ block.settings.overlay_color }};
                    --ms-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
                    --ms-card-heading-color: {{ block.settings.heading_color }};
                    --ms-button-background: {{ block.settings.button_bg }};
                    --ms-button-color: {{ block.settings.button_color }};
                  "
                  {{ block.shopify_attributes }}
                >
                  {% if bg_image != blank %}
                    {{
                      bg_image
                      | image_url: width: 900
                      | image_tag:
                        widths: '200, 400, 600, 900',
                        sizes: '(min-width: 750px) 200px, 75vw',
                        class: 'ms-hero-slide__background',
                        loading: 'lazy',
                        alt: ''
                    }}
                  {% endif %}
                  <div class="ms-hero-slide__overlay" aria-hidden="true"></div>
                  {% if product_image != blank %}
                    {{
                      product_image
                      | image_url: width: 900
                      | image_tag:
                        widths: '200, 400, 600, 900',
                        sizes: '(min-width: 750px) 200px, 75vw',
                        class: 'ms-hero-slide__product',
                        loading: image_loading,
                        fetchpriority: image_priority,
                        alt: product_image.alt
                    }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'ms-hero-slide__product ms-hero-slide__placeholder' }}
                  {% endif %}

                  {% if block.settings.heading != blank or block.settings.button_label != blank %}
                    <div class="ms-hero-slide__content">
                      {% if block.settings.heading != blank %}
                        <h3 class="ms-hero-slide__heading">{{ block.settings.heading | escape }}</h3>
                      {% endif %}
                      {% if block.settings.button_label != blank %}
                        {% if block.settings.button_link != blank %}
                          <a class="ms-hero-slide__button" href="{{ block.settings.button_link }}">
                        {% else %}
                          <span class="ms-hero-slide__button">
                        {% endif %}
                          <span>{{ block.settings.button_label | escape }}</span>
                          {% if block.settings.show_arrow %}
                            <svg class="ms-hero-slide__button-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                              <path d="M4 12h15m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
                            </svg>
                          {% endif %}
                        {% if block.settings.button_link != blank %}
                          </a>
                        {% else %}
                          </span>
                        {% endif %}
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </div>

          {% if section.blocks.size > 1 %}
            {% if section.settings.show_arrows or section.settings.show_pagination %}
              <div class="ms-hero-slider__controls">
                {% if section.settings.show_pagination %}
                  <div class="ms-hero-slider__pagination" aria-label="{{ 'accessibility.slideshow' | t }}"></div>
                {% endif %}
                {% if section.settings.show_arrows %}
                  <div class="ms-hero-slider__navigation">
                    <button class="ms-hero-slider__arrow ms-hero-slider__arrow--prev" type="button" aria-label="{{ 'accessibility.slideshow_previous' | t }}">
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M19 12H5m0 0 7 7m-7-7 7-7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
                      </svg>
                    </button>
                    <button class="ms-hero-slider__arrow ms-hero-slider__arrow--next" type="button" aria-label="{{ 'accessibility.slideshow_next' | t }}">
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M5 12h14m0 0-7-7m7 7-7 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
                      </svg>
                    </button>
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<script src="{{ 'ms-hero-slider.js' | asset_url }}" type="module" defer></script>

{% schema %}
{
  "name": "t:names.carousel",
  "tag": "section",
  "class": "ms-section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "header",
      "content": "t:content.content_layout"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Sourcing Perfume Packaging from Abely"
    },
    {
      "type": "text",
      "id": "benefit_1_heading",
      "label": "t:settings.heading",
      "default": "For Brand Owners"
    },
    {
      "type": "richtext",
      "id": "benefit_1_text",
      "label": "t:settings.text",
      "default": "<p>We walk through the journey of defining and realizing your brand's perfect perfume packaging solutions.</p>"
    },
    {
      "type": "text",
      "id": "benefit_2_heading",
      "label": "t:settings.heading",
      "default": "For Manufacturers & Suppliers"
    },
    {
      "type": "richtext",
      "id": "benefit_2_text",
      "label": "t:settings.text",
      "default": "<p>Offering high-end quality options, our qualified production plant also enables the appreciable leadtime to match your plan.</p>"
    },
    {
      "type": "text",
      "id": "benefit_3_heading",
      "label": "t:settings.heading",
      "default": "For Wholesalers"
    },
    {
      "type": "richtext",
      "id": "benefit_3_text",
      "label": "t:settings.text",
      "default": "<p>Besides perfect quality, we offer economical prices for you to satisfy your customers.</p>"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:settings.autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "t:settings.speed",
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.speed",
      "min": 200,
      "max": 1200,
      "step": 100,
      "unit": "ms",
      "default": 600
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "t:settings.loop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "t:settings.navigation",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "t:settings.pagination",
      "default": false
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "t:settings.slide_width",
      "min": 160,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "label": "t:settings.width_mobile",
      "min": 55,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "range",
      "id": "space_between",
      "label": "t:settings.slide_spacing",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "t:settings.card_height",
      "min": 240,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 300
    },
    {
      "type": "color",
      "id": "controls_color",
      "label": "t:settings.color",
      "default": "#292929"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:settings.heading",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "copy_color",
      "label": "t:settings.text_color",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.color",
      "default": "#c49a62"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:names.slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "bg_image",
          "label": "t:settings.background"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "t:settings.background_color",
          "default": "#f3f3f3"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "t:settings.overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 0
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "t:settings.overlay_color",
          "default": "#000000"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "New Designs"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:settings.label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:settings.link"
        },
        {
          "type": "checkbox",
          "id": "show_arrow",
          "label": "t:content.arrows",
          "default": true
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "t:settings.heading",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "button_bg",
          "label": "t:settings.background_color",
          "default": "#00000000"
        },
        {
          "type": "color",
          "id": "button_color",
          "label": "t:settings.color",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
