<style>
  .ms-footer {
    --ms-footer-bg: {{ section.settings.background_color }};
    --ms-footer-text: {{ section.settings.text_color }};
    padding: 40px 24px 28px;
    background: var(--ms-footer-bg);
    color: var(--ms-footer-text);
  }

  .ms-footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .ms-footer__logo {
    display: inline-block;
    color: var(--ms-footer-text);
    text-decoration: none;
  }

  .ms-footer__logo-image {
    display: block;
    width: {{ section.settings.logo_width_mobile }}px;
    max-width: 100%;
    height: auto;
  }

  .ms-footer__logo-text {
    display: block;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 2.75rem;
    font-weight: 400;
    line-height: 1;
  }

  .ms-footer__logo-sub {
    display: block;
    margin-top: 6px;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 0.875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .ms-footer__nav {
    margin-top: 28px;
  }

  .ms-footer__menu {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ms-footer__link {
    color: var(--ms-footer-text);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .ms-footer__link:hover,
  .ms-footer__link:focus-visible {
    opacity: 0.65;
  }

  .ms-footer__social {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .ms-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: var(--ms-footer-text);
    transition: opacity 0.2s ease;
  }

  .ms-footer__social-link:hover,
  .ms-footer__social-link:focus-visible {
    opacity: 0.65;
  }

  .ms-footer__social-link svg {
    width: 18px;
    height: 18px;
  }

  .ms-footer__divider {
    width: 100%;
    max-width: 748px;
    height: 1px;
    margin: 32px 0 24px;
    border: 0;
    background: var(--ms-footer-text);
    opacity: 0.2;
  }

  .ms-footer__copyright {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  @media screen and (min-width: 750px) {
    .ms-footer {
      padding: 56px 48px 32px;
    }

    .ms-footer__logo-image {
      width: {{ section.settings.logo_width_desktop }}px;
    }

    .ms-footer__logo-text {
      font-size: 3.5rem;
    }

    .ms-footer__menu {
      gap: 12px 28px;
    }

    .ms-footer__copyright {
      font-size: 0.8125rem;
    }
  }
</style>

{% capture logo_sizes %}
    (min-width: 750px) {{ section.settings.logo_width_desktop }}px, {{ section.settings.logo_width_mobile }}px
{% endcapture %}

<footer class="ms-footer" id="ms-footer-{{ section.id }}">
  <div class="ms-footer__inner">
    <a href="{{ routes.root_url }}" class="ms-footer__logo" aria-label="{{ shop.name | escape }}">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'ms-footer__logo-image',
            loading: 'lazy',
            alt: shop.name,
            widths: '200, 300, 400, 600',
            sizes: logo_sizes
        }}
      {% else %}
        <span class="ms-footer__logo-text">{{ section.settings.logo_text | default: shop.name }}</span>
        {% if section.settings.logo_subtext != blank %}
          <span class="ms-footer__logo-sub">{{ section.settings.logo_subtext }}</span>
        {% endif %}
      {% endif %}
    </a>

    {% if section.settings.menu != blank and section.settings.menu.links.size > 0 %}
      <nav class="ms-footer__nav" aria-label="Footer">
        <ul class="ms-footer__menu" role="list">
          {% for link in section.settings.menu.links %}
            <li>
              <a href="{{ link.url }}" class="ms-footer__link"{% if link.current %} aria-current="page"{% endif %}>
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ul class="ms-footer__social" role="list">
        {% for block in section.blocks %}
          {% if block.settings.url != blank %}
            <li {{ block.shopify_attributes }}>
              <a
                href="{{ block.settings.url }}"
                class="ms-footer__social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="{{ block.settings.platform | capitalize }}"
              >
                {% case block.settings.platform %}
                  {% when 'twitter' %}
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
                  {% when 'facebook' %}
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.378 14.192 5 15.115 5H18V0h-3.808C10.596 0 9 1.583 9 4.615V8z"></path></svg>
                  {% when 'instagram' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle></svg>
                  {% when 'pinterest' %}
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"></path></svg>
                  {% when 'youtube' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4"></rect><path d="M10 9.5l5 2.5-5 2.5z" fill="currentColor"></path></svg>
                {% endcase %}
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}

    <hr class="ms-footer__divider">

    <p class="ms-footer__copyright">
      &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text }}
    </p>
  </div>
</footer>

{% schema %}
{
  "name": "MS Footer",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Use a transparent PNG or SVG with light artwork. If empty, the text logo below is used."
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Logo width (mobile)",
      "min": 80,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "logo_width_desktop",
      "label": "Logo width (desktop)",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Text logo",
      "info": "Shown when no logo image is set. Leave empty to use the store name.",
      "default": "Abely"
    },
    {
      "type": "text",
      "id": "logo_subtext",
      "label": "Text logo subtitle",
      "default": "Perfume"
    },
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "info": "The year is added automatically.",
      "default": "Abely Perfume. All rights reserved."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "social",
      "name": "Social icon",
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Platform",
          "options": [
            { "value": "twitter", "label": "X (Twitter)" },
            { "value": "facebook", "label": "Facebook" },
            { "value": "instagram", "label": "Instagram" },
            { "value": "pinterest", "label": "Pinterest" },
            { "value": "youtube", "label": "YouTube" }
          ],
          "default": "facebook"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MS Footer",
      "blocks": [
        { "type": "social", "settings": { "platform": "twitter" } },
        { "type": "social", "settings": { "platform": "facebook" } },
        { "type": "social", "settings": { "platform": "instagram" } },
        { "type": "social", "settings": { "platform": "pinterest" } }
      ]
    }
  ]
}
{% endschema %}